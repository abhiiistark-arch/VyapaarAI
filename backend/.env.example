APP_NAME=VyapaarAI
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_ENCRYPT_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./vyapaarai.db
REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Keep DEMO_MODE=true until Google GBP API access is approved.
# Then: DEMO_MODE=false, USE_LIVE_GOOGLE=true + fill Google OAuth credentials.
DEMO_MODE=true
USE_LIVE_GOOGLE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/business.manage openid email profile

GEMINI_API_KEY=
# Fast free-tier default. Also works: gemini-3.8-flash, gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
