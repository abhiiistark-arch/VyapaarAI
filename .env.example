# Server-only (never prefix with NEXT_PUBLIC_)
SECRET_KEY=change-me-in-production
# Required for AI text + photorealistic GBP photos
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
DEMO_MODE=true
USE_LIVE_GOOGLE=false
APP_NAME=VyapaarAI

# Optional: only if API is hosted separately from this Next app
# NEXT_PUBLIC_API_URL=/api/v1

# Local tip: if GEMINI_API_KEY is unset, Next will also read ../backend/.env in development.
